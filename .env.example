# ---------------------------------------------------------------------------
# DistribPro — Environment variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local and NEVER expose the service role key to the browser.
# ---------------------------------------------------------------------------

# Public Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key (safe in the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key. Used ONLY by the demo seed script.
# Do NOT prefix it with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the application (used for auth redirects and invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo tenant accounts (created by `npm run seed:demo`)
DEMO_ADMIN_EMAIL=admin@atlas-demo.ma
DEMO_ADMIN_PASSWORD=Demo1234!
DEMO_CUSTOMER_EMAIL=client@atlas-demo.ma
DEMO_CUSTOMER_PASSWORD=Demo1234!
DEMO_SUPERADMIN_EMAIL=superadmin@distribpro.ma
DEMO_SUPERADMIN_PASSWORD=Demo1234!

# Optional: set to "true" once the platform is publicly launched
NEXT_PUBLIC_SHOW_DEMO=true
